
# ==============================================================================
# Orbit MCP Server — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Orbit Core Daemon Connection
# Target backend API base URL that the MCP server calls for tool execution
# ------------------------------------------------------------------------------
ORBIT_API_URL=http://localhost:8000

# Timeout in seconds for long-running agentic extraction tools
REQUEST_TIMEOUT=120.0

# Enable debug-level logging
DEBUG=false

# ------------------------------------------------------------------------------
# 2. Transport Server Mode
# Options: "stdio" (for desktop IDE clients like Claude, Cursor, VS Code)
#          "sse"   (for remote HTTP / Server-Sent Events hosting)
# ------------------------------------------------------------------------------
MCP_TRANSPORT=stdio

# Host and port for remote SSE server mode (only used when MCP_TRANSPORT=sse)
MCP_HOST=0.0.0.0
MCP_PORT=8001
